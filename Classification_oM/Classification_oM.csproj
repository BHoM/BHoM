<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<AssemblyVersion>10.0.0.0</AssemblyVersion>
		<Description>https://github.com/BHoM/BHoM</Description>
		<Version>5.0.0</Version>
		<Authors>BHoM</Authors>
		<Copyright>Copyright © https://github.com/BHoM</Copyright>
		<RootNamespace>BH.oM.Classification</RootNamespace>
		<FileVersion>10.0.0.0</FileVersion>
		<OutputPath>..\Build\</OutputPath>
	</PropertyGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="xcopy &quot;$(TargetDir)$(TargetFileName)&quot;  &quot;$(ProgramData)\BHoM\Assemblies&quot; /Y" />
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\BHoM\BHoM.csproj" />
	</ItemGroup>

</Project>
